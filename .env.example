# SSAS environment variables — server-side automation scripts (scripts/).
#
# Copy this file to scripts/.env for LOCAL testing only. In production,
# these are never read from a .env file — they're injected as GitHub
# Actions secrets (Settings → Secrets and variables → Actions) into
# .github/workflows/*.yml. Never commit a real .env file (see .gitignore).

# ── Firebase Admin SDK ──────────────────────────────────────────────
# Full service account JSON, as a single-line string. Generate at:
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. See docs/DEPLOYMENT.md §6.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Email (Gmail SMTP via Nodemailer) — see docs/EMAIL.md ──────────
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── Telegram Bot API — see docs/TELEGRAM.md ─────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# ── Google Calendar OAuth — see docs/GOOGLE-CALENDAR.md ─────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
