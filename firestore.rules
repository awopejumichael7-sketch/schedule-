rules_version = '2';

// SSAS — Firestore Security Rules
// Core principle (brief §71): request.auth.uid == userId, everywhere.
// No top-level collection is ever readable/listable across users.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    // Fields an ordinary user must never be able to write on themselves.
    function ownerWriteAllowed() {
      let incoming = request.resource.data;
      return incoming.role == resource.data.role &&   // cannot self-promote to ADMIN
             incoming.uid == resource.data.uid;         // cannot reassign uid
    }

    // ── users/{uid} ────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Admin may update only non-content fields (disabled flag) — enforced
      // by disallowing admin writes to schedules/etc. subcollections below.
      allow update: if isOwner(uid) && ownerWriteAllowed();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['disabled', 'updatedAt']);
      allow create: if isOwner(uid) &&
        request.resource.data.role == "USER"; // self-registration can never create an admin
      allow delete: if isOwner(uid);

      // ── Every private subcollection: owner-only, full stop. ──
      match /schedules/{scheduleId} {
        allow read, write: if isOwner(uid);
      }

      match /scheduleOccurrences/{occurrenceId} {
        allow read, write: if isOwner(uid);
      }

      match /completionRecords/{recordId} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        // Client may read its own notification history (§46) but never
        // write — notifications are only ever written by the Admin SDK
        // (GitHub Actions engine), which bypasses rules entirely.
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /notificationPreferences/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /calendarConnections/{connectionId} {
        // The refresh token must never be written by client JS — only by
        // the secure server-side OAuth exchange (Admin SDK). The client
        // MAY read connection status (connected/lastSyncedAt/syncStatus)
        // to render the settings page, and may write ONLY the
        // "disconnect" action (setting connected=false) and
        // selectedCalendarId.
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['connected', 'selectedCalendarId', 'updatedAt']) &&
          request.resource.data.refreshToken == resource.data.refreshToken;
      }

      match /telegramConnections/{connectionId} {
        // Same pattern: chatId is only ever set by the bot backend
        // (Admin SDK). Client may only request a link code and read status.
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkCode', 'linkCodeExpiresAt', 'linked']) &&
          (resource == null || request.resource.data.chatId == resource.data.chatId);
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(uid);
      }

      match /reports/{reportId} {
        // Reports are computed by the client from the user's own data, or
        // cached by the Admin SDK engine. Either way, owner-read-only from
        // the client; owner may also trigger a client-side recompute write.
        allow read, write: if isOwner(uid);
      }

      match /auditLog/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false; // audit entries only via Admin SDK
      }
    }

    // ── admin/{configId} — admin-only, and NEVER user content ───
    match /admin/{configId} {
      allow read, write: if isAdmin();
    }

    // ── Deny everything else by default ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
